#include "water.h"
#include "../wallpaper.h"
#include "../wrappers/basic_wrappers.h"
#include <math.h>

#define PI 3.14159265358979323846

#define WATER_PHASE_COUNT 8

static struct color lerp_color(struct color from, struct color to, double t) {
        struct color result;

        result.r = (unsigned char)(from.r + (to.r - from.r) * t);
        result.g = (unsigned char)(from.g + (to.g - from.g) * t);
        result.b = (unsigned char)(from.b + (to.b - from.b) * t);

        return result;
}

